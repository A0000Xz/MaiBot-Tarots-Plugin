{
  "manifest_version": 2,
  "id": "github.a0000xz.maibot-tarots-plugin",
  "version": "2.0.0",
  "name": "塔罗工坊",
  "description": "面向 MaiBot 新版插件系统的塔罗牌占卜插件：11 种牌阵、可自定义牌阵与牌组、桌布风布局图、麦麦人设解牌",
  "author": {
    "name": "A0000Xz",
    "url": "https://github.com/A0000Xz"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/A0000Xz/MaiBot-Tarots-Plugin",
    "homepage": "https://github.com/A0000Xz/MaiBot-Tarots-Plugin",
    "documentation": "https://github.com/A0000Xz/MaiBot-Tarots-Plugin/blob/main/README.md",
    "issues": "https://github.com/A0000Xz/MaiBot-Tarots-Plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.13",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "maisaka.reply.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "entertainment",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "sparkles"
    }
  }
}
